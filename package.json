{
  "name": "erp-financial-request-payment-control-system",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack ERP financial request and payment control system.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "seed": "npm run seed --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm start --workspace backend",
    "start:public": "npm run start:public --workspace backend",
    "share": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/share-cloudflare.ps1 start",
    "share:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/share-cloudflare.ps1 status",
    "share:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/share-cloudflare.ps1 stop",
    "share:publish": "npm run share && npm run link:publish",
    "link:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-render-link.ps1",
    "link:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-render-link.ps1 -Publish",
    "rotate:deployment-passwords": "npm run rotate:deployment-passwords --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
